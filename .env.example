# Copy this file to ins账号自动化/data/.env and fill in the real values.
# (.env is ignored by git and never uploaded.)

# OpenRouter API Key - used for AI captions, hashtags and image models (required)
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Google Gemini API Key - optional but recommended for image quality
# Free tier: 500 images/day. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Instagram account - NOT required; the normal flow is a one-time
# browser session login from the web dashboard.
IG_USERNAME=your_instagram_username
IG_PASSWORD=your_instagram_password
